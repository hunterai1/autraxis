# AUTRAXIS backend — environment example. Copy to .env and fill real values.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="autraxis"
CORS_ORIGINS="https://autraxis.com,https://www.autraxis.com"

# Emergent managed email (Resend proxy). Provisioned per-app by the platform.
# Zoho Mail (MX/DNS) is NOT affected by these settings — no DNS changes required.
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=AUTRAXIS
EMAIL_REPLY_TO=info@autraxis.com
CONTACT_INBOX=info@autraxis.com
CAREERS_INBOX=careers@autraxis.com
JWT_SECRET=
ADMIN_EMAIL=info@autraxis.com
ADMIN_PASSWORD=
FRONTEND_URL=https://autraxis.com
APP_VERSION=1.2.0
